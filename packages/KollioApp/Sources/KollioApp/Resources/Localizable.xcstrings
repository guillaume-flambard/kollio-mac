          "stringUnit": {
            "state": "translated",
            "value": "Annuler le doublon"
          }
        }
      }
    },
    "undo.duplicateVariant": {
      "comment": "Undo label: create a new idea related to the one it came from.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo variant"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler la variante"
          }
