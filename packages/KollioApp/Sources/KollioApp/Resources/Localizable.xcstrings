    "error.loadFailed": {
      "comment": "Shown when a stored document exists but cannot be read. The file is never overwritten.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved document could not be read, so nothing was replaced. It is still on disk: open it with Open, or start a new document."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document enregistré n’a pas pu être lu, rien n’a donc été remplacé. Il est toujours sur le disque : ouvrez-le, ou commencez un nouveau document."
          }
        }
      }
    },
