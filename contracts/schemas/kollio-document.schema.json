{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kollio.dev/schemas/kollio-document.schema.json",
  "title": "Kollio document",
  "description": "A versioned, portable, renderer-independent document. No SwiftUI, AppKit or platform type ever appears here.",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentId",
    "revision",
    "semanticRevision",
    "content",
    "relationships",
    "decisions",
    "presentation"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "2 adds the optional `sources` ledger. A file without it is a document that has no sources, not a broken one."
    },
    "documentId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Bumped on every accepted mutation, presentation included."
    },
    "semanticRevision": {
      "type": "integer",
      "minimum": 0,
      "description": "Bumped only when the meaning of the document changed."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "object",
      "description": "Semantic objects, keyed by stable object id.",
      "additionalProperties": {
        "$ref": "#/$defs/contentObject"
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/relationship"
      }
    },
    "decisions": {
      "type": "object",
      "description": "Durable project memory. Survives quitting, reloading and undo-stack loss.",
      "additionalProperties": {
        "$ref": "#/$defs/decision"
      }
    },
    "contributions": {
      "type": "object",
      "description": "Reusable contributions. Visual duplication never creates a new one.",
      "additionalProperties": {
        "$ref": "#/$defs/contribution"
      }
    },
    "products": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/productComposition"
      }
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "sources": {
      "type": "object",
      "description": "Source references and the citations made from them. Empty in a document with no sources.",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "citations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "size": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "localizedText": {
      "type": "object",
      "description": "Authored text. `text` is the source; `variants` holds only explicitly authored variants, never machine translations.",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "actor",
        "kind"
      ],
      "properties": {
        "actor": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "localEngine",
            "remoteModel"
          ]
        },
        "requestId": {
          "type": "string"
        },
        "proposalId": {
          "type": "string"
        }
      }
    },
    "contentObject": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text",
        "lifecycle",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "context",
            "need",
            "method",
            "technicalBlock",
            "product",
            "hypothesis",
            "constraint",
            "question",
            "evidence",
            "scenario",
            "decision",
            "note",
            "contribution"
          ]
        },
        "text": {
          "$ref": "#/$defs/localizedText"
        },
        "detail": {
          "$ref": "#/$defs/localizedText"
        },
        "lifecycle": {
          "enum": [
            "active",
            "setAside"
          ]
        },
        "setAsideByDecision": {
          "type": "string"
        },
        "contributionID": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "addresses",
            "uses",
            "dependsOn",
            "constrains",
            "supports",
            "contradicts",
            "alternativeTo",
            "derivedFrom",
            "associatedWith"
          ]
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "fromAnchor": {
          "$ref": "#/$defs/anchor"
        },
        "toAnchor": {
          "$ref": "#/$defs/anchor"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "anchor": {
      "type": "object",
      "description": "Attachment point in object-local unit space, so a connector follows its object.",
      "required": [
        "unitX",
        "unitY"
      ],
      "properties": {
        "unitX": {
          "type": "number"
        },
        "unitY": {
          "type": "number"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "targetObjectID",
        "branchObjectIDs",
        "status",
        "createdAt",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "setAside",
            "reopened",
            "kept"
          ]
        },
        "targetObjectID": {
          "type": "string"
        },
        "branchObjectIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "$ref": "#/$defs/localizedText"
        },
        "status": {
          "enum": [
            "active",
            "superseded"
          ]
        },
        "supersedes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "contribution": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "owner",
        "reusable"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "reusable": {
          "type": "boolean"
        }
      }
    },
    "productComposition": {
      "type": "object",
      "required": [
        "id",
        "name",
        "memberContributionIDs",
        "shares"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "memberContributionIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shares": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "required": [
        "instances"
      ],
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "objectID",
              "position",
              "hidden"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "objectID": {
                "type": "string"
              },
              "position": {
                "$ref": "#/$defs/position"
              },
              "size": {
                "$ref": "#/$defs/size"
              },
              "hidden": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "description": "A pointer to a resource, never a copy of it. `locator` is where the bytes actually are.",
      "required": [
        "id",
        "kind",
        "title",
        "locator",
        "revisions",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "markdown",
            "pdf",
            "csv",
            "image",
            "link",
            "other"
          ]
        },
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRevision"
          }
        }
      }
    },
    "sourceRevision": {
      "type": "object",
      "description": "One state of a source, as it was read. History is kept so a claim stays checkable against what it was based on.",
      "required": [
        "id",
        "sequence",
        "importedAt",
        "extraction",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "digest": {
          "type": "string",
          "description": "How a person is told the text is not what their claim was based on."
        },
        "extraction": {
          "$ref": "#/$defs/extraction"
        }
      }
    },
    "extraction": {
      "description": "What the app could actually get. `noText` is a real, useful answer: an image-only PDF has none.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "notAttempted"
          ],
          "additionalProperties": false,
          "properties": {
            "notAttempted": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "pending"
          ],
          "additionalProperties": false,
          "properties": {
            "pending": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ready"
          ],
          "additionalProperties": false,
          "properties": {
            "ready": {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "partial"
          ],
          "additionalProperties": false,
          "properties": {
            "partial": {
              "type": "object",
              "required": [
                "text",
                "_0"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "_0": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "noText"
          ],
          "additionalProperties": false,
          "properties": {
            "noText": {
              "type": "object",
              "required": [
                "_0"
              ],
              "additionalProperties": false,
              "properties": {
                "_0": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "unsupported"
          ],
          "additionalProperties": false,
          "properties": {
            "unsupported": {
              "type": "object",
              "required": [
                "_0"
              ],
              "additionalProperties": false,
              "properties": {
                "_0": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "missing"
          ],
          "additionalProperties": false,
          "properties": {
            "missing": {
              "type": "object",
              "required": [
                "_0"
              ],
              "additionalProperties": false,
              "properties": {
                "_0": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "description": "A claim attached to a place in an exact revision. `revisionID` is immutable on purpose.",
      "required": [
        "id",
        "sourceID",
        "revisionID",
        "locator",
        "quote",
        "recordedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceID": {
          "type": "string"
        },
        "revisionID": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "lineRange": {
              "type": [
                "object",
                "null"
              ],
              "description": "A Swift Range<Int>, encoded by Foundation as lowerBound/upperBound."
            }
          }
        },
        "status": {
          "$ref": "#/$defs/verificationStatus"
        }
      }
    },
    "verificationStatus": {
      "description": "There is no `verified` case without an observation and an author. A badge a program can set by itself means nothing.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "unverified"
          ],
          "additionalProperties": false,
          "properties": {
            "unverified": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "verified"
          ],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "object",
              "required": [
                "observation",
                "by",
                "at"
              ],
              "additionalProperties": false,
              "properties": {
                "observation": {
                  "type": "string"
                },
                "by": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "needsReview"
          ],
          "additionalProperties": false,
          "properties": {
            "needsReview": {
              "type": "object",
              "required": [
                "_0"
              ],
              "additionalProperties": false,
              "properties": {
                "_0": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "sourceMissing"
          ],
          "additionalProperties": false,
          "properties": {
            "sourceMissing": {
              "type": "object",
              "required": [
                "_0"
              ],
              "additionalProperties": false,
              "properties": {
                "_0": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    }
  }
}
